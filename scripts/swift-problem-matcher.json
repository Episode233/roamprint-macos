{
  "problemMatcher": [
    {
      "owner": "roamprint-swift",
      "pattern": [
        {
          "regexp": "^(.+?):([0-9]+):(?:([0-9]+):)?\\s+(error|warning):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      ]
    }
  ]
}
